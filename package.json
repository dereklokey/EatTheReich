{
  "name": "eat-the-reich-companion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Realtime multiplayer companion app for the tabletop RPG Eat the Reich (Havoc Engine).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "dev:worker": "wrangler dev",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.20.0"
  }
}
